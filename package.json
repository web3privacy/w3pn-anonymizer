{
  "name": "anonymizer-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "W3PN Anonymizer — privacy-first image and video anonymization tool",
  "author": "Web3Privacy Now <web3privacynow@protonmail.com>",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:ipv4": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:all": "npm run build && electron-builder -mwl",
    "desktop:mac": "npm run build && electron-builder --mac",
    "desktop:win": "npm run build && electron-builder --win",
    "desktop:linux": "npm run build && electron-builder --linux",
    "icons:download": "node scripts/download-preset-icons.mjs --count=100",
    "icons:download:new": "node scripts/download-preset-icons.mjs --only=aavegotchi,celebrities --count=100",
    "icons:normalize": "node scripts/download-preset-icons.mjs --normalize-existing",
    "icons:generate": "node scripts/generate-test-icons.mjs",
    "icons:favicons": "node scripts/generate-favicons.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "smoke": "node scripts/release-smoke.mjs",
    "smoke:vectorize": "node scripts/vectorize-e2e.mjs",
    "smoke:gl": "node scripts/gl-parity-e2e.mjs",
    "smoke:editor": "node scripts/editor-e2e.mjs",
    "smoke:visual": "node scripts/visual-e2e.mjs",
    "release:check": "npm run lint && npm run build && npm run smoke && npm run release:audit"
  },
  "build": {
    "appId": "info.web3privacy.anonymizer",
    "productName": "W3PN Anonymizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/fonts/**/*",
      "public/models/**/*",
      "public/vendor/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@9am/img-halftone": "^1.0.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "browser-image-compression": "^2.0.2",
    "file-saver": "^2.0.5",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "onnxruntime-web": "^1.25.1",
    "pdfjs-dist": "^4.10.38",
    "pica": "^9.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "smartcrop": "^2.0.5",
    "tesseract.js": "^5.1.1",
    "webm-duration-fix": "^1.0.4",
    "webm-muxer": "^5.1.4"
  },
  "overrides": {
    "protobufjs": "^7.6.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/file-saver": "^2.0.7",
    "@types/pica": "^9.0.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
