[Unit]
Description=W3PN Anonymizer feedback service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anonymizer
Group=anonymizer
UMask=0077
WorkingDirectory=/opt/w3pn-anonymizer/repo/server
EnvironmentFile=/etc/w3pn-anonymizer-feedback.env
ExecStart=/opt/w3pn-anonymizer/venv/bin/uvicorn feedback_main:app --host 127.0.0.1 --port 7866 --log-level info
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/w3pn-anonymizer
StateDirectory=w3pn-anonymizer

[Install]
WantedBy=multi-user.target
